# Copie para .env e ajuste os valores:  cp .env.example .env
# NUNCA versione o arquivo .env (ele está no .gitignore).

APP_ENV=local
APP_PORT=8080
DB_PORT=1521

# Banco Oracle (container gvenzl/oracle-free)
ORACLE_PASSWORD=troque-esta-senha
DB_USERNAME=coleta
DB_PASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens JWT
JWT_SECRET=troque-este-segredo

# Exibir SQL no log (true em dev, false em produção)
SHOW_SQL=true
