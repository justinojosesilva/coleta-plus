# Referência das variáveis do ambiente STAGING.
# No pipeline, este arquivo é gerado automaticamente a partir dos secrets do
# GitHub Environment "staging" — os valores reais nunca ficam no repositório.
APP_ENV=staging
APP_PORT=8081
SHOW_SQL=true
DB_USERNAME=coleta
DB_PASSWORD=<secret DB_PASSWORD>
ORACLE_PASSWORD=<secret ORACLE_PASSWORD>
JWT_SECRET=<secret JWT_SECRET>
IMAGE=ghcr.io/<usuario>/coleta-plus:sha-<commit>
APP_VERSION=sha-<commit>
